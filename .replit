modules = ["nodejs-24"]

[deployment]
router = "application"
# Reserved VM: games and matchmaking live in server memory, so the app must run
# as one always-on instance (autoscale can split players across instances and
# scale to zero mid-game).
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
